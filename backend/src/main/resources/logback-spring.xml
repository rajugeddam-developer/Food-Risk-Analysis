<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="60 seconds">

    <!-- Standardized structured console logging pattern with MDC correlation ID -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} [%thread] %-5level %logger{36} [reqId=%X{requestId:-none}] - %msg%n" />

    <property name="LOG_PATH" value="${LOG_PATH:-logs}" />
    <property name="LOG_FILE" value="${LOG_PATH}/food-risk-backend.log" />

    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Rolling File Appender for Production Profile -->
    <appender name="ROLLING_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- Rollover daily with compression -->
            <fileNamePattern>${LOG_PATH}/food-risk-backend-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <!-- Maximum 10MB per segment -->
            <maxFileSize>10MB</maxFileSize>
            <!-- Retain for 30 days -->
            <maxHistory>30</maxHistory>
            <!-- Total cap of 1GB -->
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Development Profile Logging -->
    <springProfile name="!prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
        </root>
        <logger name="com.foodrisk" level="DEBUG" />
    </springProfile>

    <!-- Production Profile Logging -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
            <appender-ref ref="ROLLING_FILE" />
        </root>
        <logger name="com.foodrisk" level="INFO" />
        <logger name="org.springframework.web" level="WARN" />
        <logger name="org.springframework.security" level="WARN" />
        <logger name="org.hibernate" level="WARN" />
        <logger name="com.zaxxer.hikari" level="WARN" />
    </springProfile>

</configuration>
