# ==============================================================================
# Food Risk Analysis PWA - Example Environment Configuration Template
# Copy this file to .env and adjust values for your local environment
# ==============================================================================

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=food_risk_analysis
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# JWT Security
JWT_SECRET=your_minimum_32_characters_secret_key_here_1234567890!
JWT_EXPIRATION=86400000

# Google Gemini AI API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=30

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Offline Tesseract OCR
TESSDATA_PATH=tessdata
TESSERACT_LANGUAGE=eng

# Server & CORS
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Frontend
VITE_API_BASE_URL=http://localhost:8080
